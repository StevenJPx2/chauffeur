{
  "name": "chauffeur-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build wasm --target web --dev --out-dir ../src/wasm --no-pack",
    "dev": "bun scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "build": "wasm-pack build wasm --target web --release --out-dir ../src/wasm --no-pack && vite build",
    "check": "bun run build && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "petite-vue": "0.4.1"
  }
}
