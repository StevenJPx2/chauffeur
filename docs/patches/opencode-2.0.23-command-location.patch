12 it.live("background command registration, reload and disposal keep their host Location", () =>
13   Effect.gen(function* () {
14     const plugins = yield* Plugin.Service
15     const bus = yield* Bus.Service
16     const host = yield* PluginHost.make(plugins)
17     const scope = yield* Effect.acquireRelease(Scope.make(), (scope) => Scope.close(scope, Exit.void))
18     const updates: (Location.Ref | undefined)[] = []
19     const unsubscribe = yield* bus.listen((event) =>
20       Effect.sync(() => {
21         if (event.type === "command.updated") updates.push(event.location)
22       }),
23     )
24     yield* Effect.addFinalizer(() => unsubscribe)
25 
26     // A timer invokes the host methods without the request's service context.
27     const registration = yield* Effect.promise(() =>
28       Effect.runPromise(
29         host.command.transform((editor) => {
30           editor.add({ name: "background", execute: () => Effect.void })
31         }).pipe(Effect.provideService(Scope.Scope, scope)),
32       ),
33     )
34     yield* Effect.promise(() => Effect.runPromise(host.command.reload()))
35     yield* Effect.promise(() => Effect.runPromise(registration.dispose))
36 
37     expect(updates).toHaveLength(3)
38     for (const location of updates) {
39       expect(location).toEqual({
40         directory: host.location.directory,
41         workspaceID: host.location.workspaceID,
42       })
43     }
