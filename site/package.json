{
  "name": "chauffeur-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "deploy": "vitepress build && cf deploy",
    "format": "prettier --write --ignore-path ../.gitignore '../**/*.md'",
    "format:check": "prettier --check --ignore-path ../.gitignore '../**/*.md'"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.27",
    "mermaid": "11.17.2",
    "prettier": "3.9.10",
    "vitepress": "1.6.4",
    "wrangler": "4.157.0"
  }
}
